{
	"name": "ooh-ooh",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@10.33.0",
	"engines": {
		"node": ">=22"
	},
	"scripts": {
		"dev": "pnpm --filter @ooh/web dev",
		"build": "pnpm --filter @ooh/web build",
		"preview": "pnpm --filter @ooh/web preview",
		"lint": "eslint . && node tools/check-boundaries.mjs",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"typecheck": "pnpm -r --if-present typecheck",
		"test": "vitest run --dir tools && pnpm -r --if-present test",
		"check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.0",
		"eslint": "^10.13.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.23.1",
		"globals": "^17.13.0",
		"prettier": "^3.9.10",
		"prettier-plugin-svelte": "^4.1.1",
		"svelte": "^5.57.2",
		"typescript": "~7.0.2",
		"typescript-eslint": "^8.71.2",
		"vitest": "^5.0.5"
	}
}
